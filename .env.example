# Copy this file to .env and fill in your key. Do NOT commit .env.
# Get a key at https://aistudio.google.com/apikey

GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-google-api-key   # also accepted by langchain-google-genai

# Embedding model (fixed identifier).
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Chat model. "gemini-flash-lite-latest" is a rolling alias that always points at
# the current Flash-Lite build; the dated "gemini-2.5-flash-lite" now returns 404
# for new API keys. Pin a dated id here if you need an exact, frozen model.
GEMINI_CHAT_MODEL=google_genai:gemini-flash-lite-latest
